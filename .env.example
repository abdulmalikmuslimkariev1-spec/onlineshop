# --- GENERAL ---
# APP_URL=http://localhost:3000
# PORT=3000

# --- BACKEND (FastAPI) ---
# Port for the FastAPI backend (defaults to 8001)
# BACKEND_PORT=8001

# Development secret key - change this in production
SECRET_KEY=dev_secret_key_12345

# --- DATABASE (PostgreSQL) ---
# These values are usually provided by the hosting environment (e.g. Cloud SQL)
# SQL_HOST=localhost
# SQL_USER=postgres
# SQL_PASSWORD=password
# SQL_DB_NAME=onlineshop

# --- FRONTEND (Vite) ---
# Base API URL for the frontend. 
# In development, this is proxied to localhost:8000 by Vite.
VITE_API_URL=/api
