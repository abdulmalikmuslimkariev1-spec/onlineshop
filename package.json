{
  "name": "onlineshop-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"npm run dev:frontend\" \"bash backend/start_backend.sh\"",
    "dev:frontend": "cd frontend && npm run dev -- --port 3000",
    "dev:backend": "bash backend/start_backend.sh",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint",
    "start": "npx tsx server.ts",
    "install:all": "npm install && cd frontend && npm install && cd .. && /root/.local/bin/pip install -r backend/requirements.txt"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
